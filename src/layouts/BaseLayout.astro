---
import "../styles/global.css";

const {
  title = "Game News",
  description = "Tin tức game mới nhất",
  image = "/og.jpg",
  canonical = ""
} = Astro.props;
---

<html lang="vi">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>

    <!-- SEO -->
    <meta
      name="description"
      content={description}
    />

    <link
      rel="canonical"
      href={canonical}
    />

    <!-- Open Graph -->
    <meta
      property="og:type"
      content="article"
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:image"
      content={image}
    />

    <!-- Twitter -->
    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={image}
    />

  </head>

  <body class="bg-[#efefef] text-[#222]">

    <!-- Header -->
  <header class="bg-red-600 text-white shadow-md">
  <div class="max-w-[1180px] mx-auto px-3 md:px-5">
    <div class="h-[72px] flex flex-col md:flex-row md:items-center md:justify-between py-2 md:py-0 gap-2 md:gap-0">
      
      <a href="/" class="text-[24px] md:text-[34px] font-bold tracking-tight leading-none">
        DEMO NEWS
      </a>

      <form action="/search" method="GET" class="relative w-full md:w-[320px]">
        <input 
          type="text" 
          name="q" 
          placeholder="Search..." 
          required
          class="w-full bg-white/10 hover:bg-white/15 focus:bg-white text-white focus:text-gray-900 placeholder-white/70 focus:placeholder-gray-400 pl-4 pr-10 py-2 rounded-lg border border-white/20 focus:border-white text-sm outline-none transition-all"
        />
        <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 text-white/70 hover:text-white focus:text-gray-950">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 currentColor" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
      </form>

    </div>
  </div>
</header>

    <!-- Page Content -->
    <div>

      <slot />

    </div>

    <!-- Footer -->
    <footer class="bg-[#111] text-gray-400 mt-10">

      <div
        class="
          max-w-[1180px]
          mx-auto
          px-4
          py-8
          text-sm
        "
      >

        <div class="font-bold text-white text-lg">

          GAME NEWS

        </div>

        <p class="mt-3 leading-7 max-w-[700px]">

          Blog game cập nhật nhanh
          các thông tin mới nhất về eSports,
          mobile, console, PC gaming và
          công nghệ giải trí.

        </p>

        <div
          class="
            mt-6
            pt-5
            border-t
            border-[#2a2a2a]
            text-[13px]
          "
        >

          © 2026 Game News.
          All rights reserved.

        </div>

      </div>

    </footer>

  </body>

</html>